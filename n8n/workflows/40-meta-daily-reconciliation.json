      "id": "eeaf2ecc-821d-502d-902c-a23b06a16064",
      "name": "Pages the system user manages",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        0
      ],
      "credentials": {
        "facebookGraphApi": {
          "id": "meta-graph",
          "name": "Meta Graph API (system user)"
        }
      }
    },
    {
      "parameters": {
        "fieldToSplitOut": "data",
        "options": {}
      },
      "id": "0a076f84-6819-5edf-87d9-b445bf468274",
      "name": "One item per page",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://graph.facebook.com/v26.0/{{ $json.id }}/leadgen_forms",
        "authentication": "none",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "fields",
              "value": "id,name,status"
            },
            {
              "name": "limit",
              "value": "100"
            },
            {
              "name": "access_token",
              "value": "={{ $json.access_token }}"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "id": "29c4d64c-d0c7-5433-b5b4-7fdbbd7b5982",
      "name": "Lead forms on the page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Every form on every connected Page that can still hold recent leads.\nconst since = Math.floor(Date.now() / 1000) - 3 * 24 * 3600;  // last 3 days\nconst forms = [];\n$input.all().forEach((item, i) => {\n  const page = $('One item per page').itemMatching(i).json;\n  for (const form of item.json.data || []) {\n    if (['DELETED', 'DRAFT'].includes(form.status)) continue;\n    forms.push({ json: { form_id: String(form.id), page_id: String(page.id), page_token: page.access_token, since } });\n  }\n});\nreturn forms;"
      },
      "id": "ddf9f4a0-a25a-506b-9448-0c458329d477",
      "name": "Forms to check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://graph.facebook.com/v26.0/{{ $json.form_id }}/leads",
        "authentication": "none",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "fields",
              "value": "id,created_time,field_data,form_id,ad_id,adset_id,campaign_id,platform,is_organic"
            },
            {
              "name": "limit",
              "value": "500"
            },
            {
              "name": "filtering",
              "value": "=[{\"field\":\"time_created\",\"operator\":\"GREATER_THAN\",\"value\":{{ $json.since }}}]"
            },
            {
              "name": "access_token",
              "value": "={{ $json.page_token }}"
            }
          ]
        },
        "options": {
          "timeout": 30000,
          "pagination": {
            "pagination": {
              "paginationMode": "responseContainsNextURL",
              "nextURL": "={{ $response.body.paging?.next }}",
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ !$response.body.paging?.next }}"
            }
          }
        }
      },
      "id": "2e6f72a7-7378-5e6b-989c-ba79f287de93",
      "name": "Recent form leads",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const leads = [];\n$input.all().forEach((item, i) => {\n  const form = $('Forms to check').itemMatching(i).json;\n  for (const lead of item.json.data || []) leads.push({ ...lead, page_id: form.page_id });\n});\nreturn [{ json: { event_ids: leads.map(l => String(l.id)), leads } }];"
      },
      "id": "62213da5-242c-5c07-8123-beb8663a457a",
      "name": "Collect lead IDs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://odoo:8069/json/2/snaphomz.inbound.event/find_missing_events",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Odoo-Database",
              "value": "snaphomz"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ provider: 'meta', event_ids: $json.event_ids }) }}",
        "options": {
          "timeout": 20000
        }
      },
      "id": "30a08d41-ecce-51b1-92fa-580a3c48bf11",
      "name": "Find unprocessed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "odoo-integration-key",
          "name": "Odoo integration API key"
        }
      },
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const missing = new Set($json.missing || []);\nconst leads = $('Collect lead IDs').first().json.leads.filter(l => missing.has(String(l.id)));\nreturn leads.map(json => ({ json }));"
      },
      "id": "e59e8262-360f-53e1-84d8-a29539c1ab7f",
      "name": "Missing leads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Map a Meta lead (Graph API lead with field_data) to the canonical Snaphomz\n// intake payload. Odoo enforces identity and ownership rules; this node only\n// reshapes data.\nconst STANDARD = new Set(['full_name', 'first_name', 'last_name', 'email', 'phone_number', 'phone',\n  'city', 'state', 'zip_code', 'post_code', 'country']);\n\nfunction flatten(lead) {\n  const out = {};\n  for (const f of lead.field_data || []) out[f.name] = (f.values || [])[0] ?? null;\n  return out;\n}\n\nreturn $input.all().map(({ json: lead }) => {\n  const d = flatten(lead);\n  const pick = (...keys) => keys.map(k => d[k]).find(v => v !== undefined && v !== null && v !== '') ?? null;\n  const answers = {};\n  for (const [k, v] of Object.entries(d)) if (!STANDARD.has(k)) answers[k] = v;\n  // A custom checkbox whose key contains \"consent\" records marketing consent.\n  const consentKey = Object.keys(answers).find(k => k.toLowerCase().includes('consent'));\n  const consent = consentKey ? ['yes', 'true', '1', 'i agree'].includes(String(answers[consentKey]).toLowerCase()) : false;\n  const id = (v) => (v === undefined || v === null || v === '') ? null : String(v);\n  return {\n    json: {\n      payload: {\n        provider: 'meta',\n        event_type: 'lead_form',\n        event_id: String(lead.id),\n        event_time: lead.created_time,\n        person: {\n          name: pick('full_name'),\n          first_name: pick('first_name'),\n          last_name: pick('last_name'),\n          email: pick('email'),\n          phone: pick('phone_number', 'phone'),\n          country_code: pick('country'),\n        },\n        buyer_needs: { locations: pick('city', 'zip_code', 'post_code') },\n        attribution: {\n          source: lead.platform === 'ig' ? 'instagram' : 'facebook',\n          medium: lead.is_organic ? 'social' : 'paid_social',\n          campaign: lead.campaign_name || null,\n          meta: {\n            page_id: id(lead.page_id),\n            form_id: id(lead.form_id),\n            campaign_id: id(lead.campaign_id),\n            adset_id: id(lead.adset_id),\n            ad_id: id(lead.ad_id),\n            lead_id: String(lead.id),\n          },\n        },\n        consent: consent ? { marketing_email: true, source: 'meta lead form', captured_at: lead.created_time } : {},\n        answers,\n      },\n    },\n  };\n});"
      },
      "id": "fd2031ac-9a0e-50e2-84c4-513f1b32a30e",
      "name": "Map to intake payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
