        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ payload: $json.payload }) }}",
        "options": {
          "timeout": 20000
        }
      },
      "id": "fd06197f-af5f-52f1-a6d0-08a85a963e62",
      "name": "Submit missing to Odoo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
