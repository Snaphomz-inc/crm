# Copy to .env and fill in real values on the server. Never commit .env.
# Generate random values with:  openssl rand -base64 32

# --- Hostnames (subject to DNS availability) ---
CRM_HOSTNAME=crm.snaphomz.com
HOOKS_HOSTNAME=hooks.snaphomz.com
ACME_EMAIL=ops@snaphomz.com

# --- Odoo database (separate user and volume from n8n) ---
ODOO_DB_NAME=snaphomz
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=change-me

# --- n8n database (separate user and volume from Odoo) ---
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=change-me

# --- n8n ---
# Keep a copy of this key in the secret store: without it, restored n8n
# credentials cannot be decrypted.
N8N_ENCRYPTION_KEY=change-me
GENERIC_TIMEZONE=UTC

# --- Backups ---
# Off-server destination understood by scripts/backup.sh (rclone remote:path)
BACKUP_REMOTE=offsite:snaphomz-crm-backups
BACKUP_GPG_RECIPIENT=ops@snaphomz.com
BACKUP_RETENTION_DAYS=14
