<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Roles
        * Salesperson  = Sales / User: Own Documents Only (assigned buyers only).
        * Manager      = Sales / User: All Documents (all buyers, reassignment, reports).
        * Integration  = dedicated API-key user below; no sales menus, no settings.
    -->
    <record id="group_snaphomz_integration" model="res.groups">
        <field name="name">Snaphomz integration service</field>
        <field name="comment">Technical user for n8n, the Snaphomz backend and Loops webhooks. Never assign to people.</field>
        <field name="api_key_duration">366</field>
    </record>

    <data noupdate="1">
        <!-- Salespeople see only buyers assigned to them (Odoo's default also shows unassigned leads). -->
        <record id="rule_lead_salesperson_assigned_only" model="ir.rule">
            <field name="name">Snaphomz: salesperson sees assigned buyers only</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        </record>

        <record id="rule_activity_report_salesperson_assigned_only" model="ir.rule">
            <field name="name">Snaphomz: salesperson activity analysis on own buyers</field>
            <field name="model_id" ref="crm.model_crm_activity_report"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        </record>

        <!-- Buyer contacts follow the same ownership; non-buyer contacts are unaffected. -->
        <record id="rule_partner_salesperson_own_buyers" model="ir.rule">
            <field name="name">Snaphomz: salesperson sees own buyer contacts</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain_force">['|', ('snaphomz_person_uuid', '=', False), ('snaphomz_owner_user_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
            <field name="perm_create" eval="False"/>
        </record>
        <record id="rule_partner_all_documents" model="ir.rule">
            <field name="name">Snaphomz: all-documents users see all contacts</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman_all_leads'))]"/>
        </record>

        <record id="rule_inquiry_salesperson" model="ir.rule">
            <field name="name">Snaphomz: inquiries of own buyers</field>
            <field name="model_id" ref="model_snaphomz_inquiry"/>
            <field name="domain_force">[('lead_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        </record>
        <record id="rule_inquiry_all" model="ir.rule">
            <field name="name">Snaphomz: all inquiries</field>
            <field name="model_id" ref="model_snaphomz_inquiry"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman_all_leads'))]"/>
        </record>

        <record id="rule_stage_history_salesperson" model="ir.rule">
            <field name="name">Snaphomz: stage history of own buyers</field>
            <field name="model_id" ref="model_snaphomz_stage_history"/>
            <field name="domain_force">[('lead_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        </record>
        <record id="rule_stage_history_all" model="ir.rule">
            <field name="name">Snaphomz: all stage history</field>
            <field name="model_id" ref="model_snaphomz_stage_history"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman_all_leads'))]"/>
        </record>

        <record id="rule_buyer_report_salesperson" model="ir.rule">
            <field name="name">Snaphomz: own buyer analysis</field>
            <field name="model_id" ref="model_snaphomz_buyer_report"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        </record>
        <record id="rule_buyer_report_all" model="ir.rule">
            <field name="name">Snaphomz: all buyer analysis</field>
            <field name="model_id" ref="model_snaphomz_buyer_report"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman_all_leads'))]"/>
        </record>
    </data>
</odoo>
