<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!--
        PLACEHOLDER staffed hours: Antony and the sales owner must confirm the
        staffed days, hours and timezone before the first-contact reminder cron
        is enabled. Do not assume the Hyderabad office schedule covers US buyers.
    -->
    <record id="calendar_sales_coverage" model="resource.calendar">
        <field name="name">Snaphomz buyer coverage (CONFIRM BEFORE GO-LIVE)</field>
        <field name="tz">America/New_York</field>
        <field name="company_id" eval="False"/>
        <field name="attendance_ids" eval="[(5, 0, 0)] + [
            (0, 0, {'name': name, 'dayofweek': day, 'hour_from': 9.0, 'hour_to': 18.0, 'day_period': 'full_day'})
            for day, name in [('0', 'Monday'), ('1', 'Tuesday'), ('2', 'Wednesday'), ('3', 'Thursday'), ('4', 'Friday')]
        ]"/>
    </record>
</odoo>
