<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="snaphomz_qualify_view_form" model="ir.ui.view">
        <field name="name">snaphomz.qualify.form</field>
        <field name="model">snaphomz.qualify</field>
        <field name="arch" type="xml">
            <form string="Qualify buyer">
                <field name="lead_id" invisible="1"/>
                <group>
                    <field name="readiness" widget="radio"/>
                    <field name="reason" placeholder="Why: timeline, financing, motivation, representation…"/>
                </group>
                <group string="Next step" invisible="readiness != 'ready_now'">
                    <field name="next_action" required="readiness == 'ready_now'"/>
                    <field name="next_action_at" required="readiness == 'ready_now'"/>
                </group>
                <group string="Nurture" invisible="readiness not in ('needs_preparation', 'exploring')">
                    <field name="nurture_reason_id" required="readiness in ('needs_preparation', 'exploring')"
                           options="{'no_create': True}"/>
                    <field name="nurture_review_date" required="readiness in ('needs_preparation', 'exploring')"/>
                </group>
                <group string="Close" invisible="readiness != 'unqualified'">
                    <field name="lost_reason_id" required="readiness == 'unqualified'" options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_apply" string="Confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
